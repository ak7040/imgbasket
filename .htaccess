# ImgBasket: every request that isn't a real file goes to index.php
Options -Indexes
DirectoryIndex index.php

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

RewriteEngine On
# App code, config and stored files are never served directly
RewriteRule ^app(/|$) - [F,L]
RewriteRule ^scripts(/|$) - [F,L]
RewriteRule ^composer\.(json|lock)$ - [F,L]
# Libraries are never served either, except MadelineProto's worker entry point: on hosts without
# proc_open, MadelineProto starts its Telegram worker by requesting this file from the site itself
# (always with MadelineSelfRestart=1 in the query; anything else is refused)
RewriteCond %{QUERY_STRING} (^|&)MadelineSelfRestart=1(&|$)
RewriteRule ^vendor/danog/madelineproto/src/Ipc/Runner/entry\.php$ - [L]
RewriteRule ^vendor(/|$) - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]

AddType application/manifest+json .webmanifest

# Faster pages (a ranking signal): compress text and let browsers cache static files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>
